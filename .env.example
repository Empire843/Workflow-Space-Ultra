# ==================== Chrome paths ====================
# Bỏ trống để auto-detect Chrome trên Windows
CHROME_EXE_PATH=

# ==================== VEO Profile ====================
VEO_CDP_HOST=127.0.0.1
VEO_CDP_PORT=9222
VEO_CHROME_USER_DATA_DIR=./chrome_user_data
VEO_FLOW_URL=https://labs.google/fx/vi/tools/flow

# Tier gói VEO: NORMAL | PRO | ULTRA (mặc định ULTRA)
VEO_TYPE_ACCOUNT=ULTRA
# Optional: override projectId/sessionId nếu biết trước; nếu để trống sẽ auto-detect từ URL khi mở Flow
VEO_PROJECT_ID=
VEO_SESSION_ID=

# ==================== Grok Profile ====================
GROK_CDP_HOST=127.0.0.1
GROK_CDP_PORT=9223
GROK_CHROME_USER_DATA_ROOT=./chrome_user_data_grok
GROK_PROFILE_NAME=PROFILE_1
GROK_URL=https://grok.com/

# ==================== ChatGPT GPT Action (OAuth) ====================
# Public URL WSU is reachable at from the internet. Required when exposing WSU
# as a ChatGPT Custom GPT Action — ChatGPT's servers cannot reach localhost,
# so the user runs a tunnel (ngrok / cloudflared / Tailscale Funnel) and puts
# the resulting hostname here. All OAuth + OpenAPI URLs in the Settings UI
# are computed from this value. See wiki/features/chatgpt-action.md.
WSU_PUBLIC_BASE_URL=

# ==================== App ====================
# headful | offscreen | headless
# - headful: hiển thị bình thường (mặc định, tiện để login lần đầu)
# - offscreen: window đặt ngoài màn hình (-32000,-32000)
# - headless: không UI (đôi khi bị Google chặn login)
CHROME_WINDOW_MODE=headful

# ==================== Performance (R2 — batcher) ====================
# Gộp các request `gen.image` đồng thời thành 1 API call `batchGenerateImages`
# dùng chung 1 reCAPTCHA token → tiết kiệm (N-1) × (reCAPTCHA + roundtrip).
# Bật "1" để kích hoạt. Khi bật:
#   - Lane `veo-image` tự động mở concurrency = VEO_IMAGE_BATCH_MAX.
#   - N node gen.image trong cùng cửa sổ VEO_IMAGE_BATCH_WINDOW_MS → 1 HTTP call.
#   - Khác modelLabel không gộp (split thành nhiều batch nhỏ).
#   - Fallback tự động sang individual call nếu demux thất bại (0 data loss).
# Chi tiết: wiki/plans/refactor-parallel.md §R2 (private submodule).
VEO_IMAGE_BATCH=
VEO_IMAGE_BATCH_MAX=4
VEO_IMAGE_BATCH_WINDOW_MS=300

# ==================== Debug ====================
# Capture mode: khi VEO đổi schema API → bật "1" để tắt CDP block và log
# nguyên vẹn request body mà UI labs.google gửi (batchGenerateImages, …).
# Request vẫn bị fulfill 403 → không tốn quota. Để trống/0 khi dùng bình thường.
# Xem chi tiết trong wiki/operations/debugging-veo.md (private submodule).
VEO_CAPTURE_PAYLOADS=
