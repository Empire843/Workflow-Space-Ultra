.next/
out/
build/
dist/
dist-mcp/

# ==================== env / secrets ====================
.env
.env.local
.env.*.local
*.pem
*.key

# ==================== runtime data (NHẠY CẢM) ====================
# Chrome profile chứa toàn bộ cookie, session, login của Google & Grok
chrome_user_data/
chrome_user_data_grok/

# Video/ảnh user đã tạo
downloads/

# Workflow data (có thể chứa base64 ảnh upload, prompt riêng tư)
Workflows/

# Token cache cực nhạy cảm: chứa Google OAuth access_token, cookie, sessionId,
# projectId, email account, Grok statsig headers, …
# → Ignore toàn bộ folder data_general ngoại trừ .gitkeep + file example.
data_general/*
!data_general/.gitkeep
!data_general/*.example.json

# Debug dump
.debug/

# ==================== logs ====================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime error log (logs/error.log + rotations)
logs/

# ==================== typescript ====================
*.tsbuildinfo
next-env.d.ts

# ==================== IDE / OS ====================
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

